# =============================================================================
# Pre-prod environment template for compose.preprod.yaml
# Copy to .env.preprod and fill in real values (never commit .env.preprod):
#   cp .env.preprod.example .env.preprod
# Run:
#   docker compose --env-file .env.preprod -f compose.preprod.yaml up --build
# =============================================================================

# --- POSTGRES --------------------------------------------------------------
# POSTGRES_HOST / POSTGRES_PORT are OVERRIDDEN by compose.preprod.yaml
# (set to the "postgres" service on 5432). Kept here for completeness.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kara_prod
POSTGRES_USER=kara
POSTGRES_PASSWORD=change-me

# --- REDIS -----------------------------------------------------------------
# REDIS_HOST / REDIS_PORT are OVERRIDDEN by compose.preprod.yaml (service "redis").
REDIS_HOST=redis
REDIS_PORT=6379

# --- API -------------------------------------------------------------------
# API_PORT = host port mapped to the container's 8080 (see ports: in compose).
API_PORT=8080
PICKUP_DELAY_DAY=3

# --- CADDY (reverse-proxy TLS) ---------------------------------------------
# Consumed by the Caddyfile (mounted into the caddy service via env_file).
DOMAIN=api.karapi.fr
# Let's Encrypt contact email (certificate-expiry notices) — FILL IN before deploy.
ACME_EMAIL=

# --- GEOCODING (Base Adresse Nationale — free, no key, France only) ---------
GEOCODING_BASE_URL=https://api-adresse.data.gouv.fr

# --- FIREBASE (Cloud Messaging) --------------------------------------------
# base64 of the service-account JSON.
FIREBASE_CREDENTIALS_BASE64=

# --- JWT (RS256) — base64 DER key pair -------------------------------------
# Generate a dedicated pair per environment (do NOT reuse dev keys):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -outform DER | base64 -w0          # -> JWT_PRIVATE_KEY
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w0  # -> JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- MAIL (SMTP) -----------------------------------------------------------
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@karapi.fr

# --- CDN / Google Cloud Storage --------------------------------------------
GCS_BUCKET_PUBLIC=karapi-ee1cd-public
GCS_BUCKET_PRIVATE=karapi-ee1cd-private
GCS_CDN_BASE_URL=https://storage.googleapis.com/karapi-ee1cd-public

# --- STRIPE ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_MOBILE_API_VERSION=2020-08-27

# --- INVOICE (PDF receipt seller header) -----------------------------------
INVOICE_SELLER_NAME=Kara SAS
INVOICE_SELLER_ADDRESS=1 rue de la Fete, 75001 Paris, France
INVOICE_SELLER_EMAIL=facturation@kara.example

# =============================================================================
# MONITORING (compose.monitoring.yaml) — Prometheus + Grafana + Loki
# Consumed only when the monitoring stack is started. See monitoring/README.md.
# =============================================================================

# --- GRAFANA ---------------------------------------------------------------
# Admin password for the Grafana web UI (user "admin"). Set a strong secret.
# Grafana listens on 127.0.0.1:3000 only and is reached over Tailscale (never public).
GF_SECURITY_ADMIN_PASSWORD=

# --- POSTGRES EXPORTER -----------------------------------------------------
# DSN used by postgres_exporter to connect to the "postgres" service over kara_net.
# Reuse the Postgres credentials above. sslmode=disable is fine on the internal Docker network.
# NOTE: compose.monitoring.yaml already builds this DSN from POSTGRES_* by default; only set
# POSTGRES_EXPORTER_DSN if you want to override it (e.g. a read-only monitoring role).
POSTGRES_EXPORTER_DSN=postgresql://kara:change-me@postgres:5432/kara_prod?sslmode=disable
