# POSTGRES ENV

POSTGRES_HOST=localhost
POSTGRES_PORT=5432

POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword

POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# REDIS ENV

REDIS_HOST=localhost
REDIS_PORT=6379

# RABBITMQ ENV — traitement d'image asynchrone (worker Rust kara_image_worker)
# %2f = vhost "/" encodé. Aligner les identifiants sur ceux du service rabbitmq de compose.yaml.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

# API

API_PORT=8080
PICKUP_DELAY_DAY=3

# GEOCODING (Base Adresse Nationale — gratuit, sans clé, France uniquement)
GEOCODING_BASE_URL=https://api-adresse.data.gouv.fr

# FIREBASE (Firebase Cloud Messaging)

FIREBASE_CREDENTIALS_BASE64=

# JWT (RS256) — paire de clés de dev jetable, à régénérer pour tout environnement réel :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -outform DER | base64 -w0          # -> JWT_PRIVATE_KEY
#   openssl pkey -in private.pem -pubout -outform DER | base64 -w0  # -> JWT_PUBLIC_KEY

JWT_PRIVATE_
JWT_PUBLIC_

# A2F (TOTP) — clé de chiffrement des secrets TOTP en base (AES-256-GCM).
# 32 octets encodés en base64, à régénérer pour tout environnement réel :
#   openssl rand -base64 32                                          # -> TWO_FACTOR_ENCRYPTION_KEY
# Perdre cette clé rend tous les secrets A2F stockés indéchiffrables : les comptes devront
# reconfigurer leur A2F depuis zéro.

TWO_FACTOR_ENCRYPTION_KEY=WAHbZKGBCDibhPlfndmJFaNFpDOllA+1rbWfNGwq39k=

# MAIL (SMTP) — fonctionne avec n'importe quel fournisseur compatible SMTP, changer juste ces valeurs :
#   Resend  : MAIL_HOST=smtp.resend.com                       MAIL_PORT=587 MAIL_USERNAME=resend           MAIL_PASSWORD=<clé API Resend>
#   AWS SES : MAIL_HOST=email-smtp.<region>.amazonaws.com     MAIL_PORT=587 MAIL_USERNAME=<SMTP username>  MAIL_PASSWORD=<SMTP password>

MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@karapi.fr

# CDN
GCS_BUCKET_PUBLIC=karapi-ee1cd-public
GCS_BUCKET_PRIVATE=karapi-ee1cd-private
GCS_CDN_BASE_URL=https://storage.googleapis.com/karapi-ee1cd-public

# STRIPE (paiement « payer tout ») — clés du dashboard Stripe. Ne jamais committer les vraies valeurs.
#   STRIPE_SECRET_KEY      : clé secrète serveur (sk_...)
#   STRIPE_PUBLISHABLE_KEY : clé publiable transmise au front (pk_...)
#   STRIPE_WEBHOOK_SECRET  : secret de signature du endpoint webhook (whsec_...)
#   STRIPE_MOBILE_API_VERSION : version d'API du SDK MOBILE (flutter_stripe) pour sceller la clé éphémère
#                               du PaymentSheet. flutter_stripe 13.1.0 => 2020-08-27.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_MOBILE_API_VERSION=2020-08-27

# --- RABBIT MQ ---
RABBITMQ_USER=thomas.poupard
RABBITMQ_PASSWORD=dvucCgsDy66z&W88%PSJyXhy42FB3Sfk
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2f

