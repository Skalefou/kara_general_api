# kara-image-worker — environment configuration.
# Copy to `.env` and fill in the secrets. All values are validated at startup
# (a missing required value or an invalid number aborts the boot).

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_URL=amqp://user:pass@localhost:5672/%2f
QUEUE_JOBS=image-jobs
QUEUE_RESULTS=image-results
PREFETCH_COUNT=8
MAX_CONCURRENCY=8

# --- Object storage (Google Cloud Storage via S3 interop) -------------------
S3_ENDPOINT=https://storage.googleapis.com
S3_REGION=auto
S3_ACCESS_KEY=            # GCS HMAC access key
S3_SECRET_KEY=            # GCS HMAC secret

# --- Validation limits ------------------------------------------------------
MAX_IMAGE_BYTES=5242880   # 5 MiB, aligned with the API upload cap
MAX_DIMENSION=8000

# --- Retry policy -----------------------------------------------------------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=200

# --- Observability ----------------------------------------------------------
METRICS_PORT=9100
RUST_LOG=info
