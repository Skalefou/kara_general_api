{
  "permissions": {
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.*)",
      "Bash(cat .env.local)",
      "Bash(cat ./.env.local)",
      "Bash(cat .env.*)",
      "Bash(cat ./.env.*)",
      "Bash(head .env.*)",
      "Bash(tail .env.*)",
      "Bash(less .env.*)",
      "Bash(more .env.*)",
      "Bash(strings .env.*)",
      "Bash(grep .env.*)"
    ]
  }
}
